# Public Supabase keys (safe for the browser). Used from Phase 2 onward.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only Supabase service role key (used by Next.js server routes).
# WARNING: Keep this secret. Do NOT commit a real key to the repo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Simple admin API key for server-side admin endpoints (keep secret)
ADMIN_API_KEY=change-this-to-a-long-random-secret

# You can expose a public admin helper key if you want client-side admin pages to call admin endpoints
# NEXT_PUBLIC_ADMIN_API_KEY=optional-for-local-dev


# Site URL for canonical links, sitemap, and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (Phase 3+). Leave empty until you connect a provider.
# Do not put secrets in NEXT_PUBLIC_ variables.
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=Bar-Gains & Company <hello@example.com>
